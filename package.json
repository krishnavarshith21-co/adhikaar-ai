{
  "name": "adhikaar-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@adhikaar/web",
    "dev:web": "npm run dev --workspace=@adhikaar/web",
    "dev:backend": "./apps/api/mvnw -f apps/api/pom.xml spring-boot:run",
    "build": "npm run build --workspace=@adhikaar/web",
    "build:web": "npm run build --workspace=@adhikaar/web",
    "build:backend": "./apps/api/mvnw -f apps/api/pom.xml package -DskipTests",
    "start": "npm run start --workspace=@adhikaar/web",
    "lint": "npm run lint --workspace=@adhikaar/web",
    "typecheck": "npm run typecheck --workspace=@adhikaar/web",
    "test": "npm run test --workspace=@adhikaar/web",
    "test:web": "npm run test --workspace=@adhikaar/web",
    "test:api": "npm run test:api --workspace=@adhikaar/web",
    "test:nav": "npm run test:nav --workspace=@adhikaar/web",
    "test:speech": "npm run test:speech --workspace=@adhikaar/web",
    "test:backend": "./apps/api/mvnw -f apps/api/pom.xml test"
  }
}
