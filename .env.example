# Optional legacy OpenAI provider fallback
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Only for a local HTTP production preview. Omit in HTTPS deployments.
# COOKIE_SECURE=false
# Set DB_PASSWORD separately for Java/Docker; Next.js does not pass it to Java.

# Temporary local-development diagnostics only; both gates are ignored in production.
# SPEECH_DEBUG=true
# NEXT_PUBLIC_SPEECH_DEBUG=true
# Alternatively enable client playback at /app/assistant?speechDebug=1 under next dev.
