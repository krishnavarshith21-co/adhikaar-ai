# Next.js server only. Copy to .env.local; never prefix secrets with NEXT_PUBLIC_.
BACKEND_URL=http://localhost:8080
GEMINI_API_KEY=AIzaSyBLmPKURVJRa6RjOiIOUMcJBRBwNQSR24w
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
